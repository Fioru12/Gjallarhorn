# Gjallarhorn configuration file.
# Copy this file to config.yaml and fill in the channels you want to use.
# Any value here can also be set (or overridden) via environment variables -
# see .env.example. Environment variables always win over config.yaml.
# A channel left blank is simply skipped at send time, never a crash.

hub:
  dedup_window_seconds: 300
  default_channels: ["telegram", "webhook", "teams", "email"]
  db_path: "gjallarhorn.db"

telegram:
  bot_token: ""
  chat_id: ""

webhook:
  url: ""

teams:
  url: ""

jira:
  base_url: ""
  email: ""
  api_token: ""
  project_key: ""
  issue_type: "Bug"

servicenow:
  instance: ""
  username: ""
  password: ""
  table: "incident"

smtp:
  host: ""
  port: 587
  username: ""
  password: ""
  from_addr: ""
  to_addrs: []
  use_tls: true
