# Configuration
# Copy this file to .env and fill in your values

# Required for a stable API key across restarts (otherwise a random one is
# generated and printed to stdout each time the hub starts)
GJALLARHORN_API_KEY=change-this-to-a-random-secret-key

# Hub behavior
GJALLARHORN_DEDUP_WINDOW_SECONDS=300
GJALLARHORN_DEFAULT_CHANNELS=telegram,webhook,email
GJALLARHORN_DB_PATH=gjallarhorn.db

# Telegram channel (optional - skipped if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook channel - Slack/Discord compatible (optional - skipped if not set)
WEBHOOK_URL=

# SMTP email channel (optional - skipped if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
