# Configuration
# Copy this file to .env and fill in your values

# Required for a stable API key across restarts (otherwise a random one is
# generated and printed to stdout each time the hub starts)
GJALLARHORN_API_KEY=change-this-to-a-random-secret-key

# Hub behavior
GJALLARHORN_DEDUP_WINDOW_SECONDS=300
GJALLARHORN_DEFAULT_CHANNELS=telegram,webhook,email
GJALLARHORN_DB_PATH=gjallarhorn.db

# Telegram channel (optional - skipped if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook channel - Slack/Discord compatible (optional - skipped if not set)
WEBHOOK_URL=

# Microsoft Teams channel - Incoming Webhook (optional - skipped if not set)
TEAMS_WEBHOOK_URL=

# Jira ticketing channel - creates an issue from each alert (optional).
# Needs base_url (e.g. https://yourorg.atlassian.net), an account email and an
# Atlassian API token. Add "jira" to GJALLARHORN_DEFAULT_CHANNELS to enable,
# or pass channels=["jira"] per-notification.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# ServiceNow ticketing channel - creates an incident from each alert (optional).
# Needs the instance URL (e.g. https://dev12345.service-now.com) and Basic auth
# credentials of an account allowed to create records in the table.
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident

# SMTP email channel (optional - skipped if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
